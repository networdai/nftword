        <mxCell id="unresolved" parent="1" style="whiteSpace=wrap;html=1;fontFamily=PeydaWebVF;fontSize=17;fontColor=#724911;fillColor=#fff1df;strokeColor=#c58d42;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=12;overflow=hidden;rounded=0;fontSource=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fnetwordai%2Fnftword%40main%2FPeydaWebVF.woff;" value="&lt;div style=&quot;width:585px;max-width:100%;margin:auto;&quot;&gt;&lt;div dir=&quot;rtl&quot; style=&quot;font-size: 20px; font-weight: bold; line-height: 1.45; text-align: center;&quot;&gt;نامزدِ حل‌نشده؛ بدون اعتبار قطعی&lt;/div&gt;&lt;div dir=&quot;rtl&quot; style=&quot;font-size: 17px; line-height: 1.55; text-align: center; margin-top: 7px;&quot;&gt;رویدادهای خام قابل ثبت‌اند؛ نتیجهٔ معاملاتی از شرط نامعلوم ساخته نمی‌شود.&lt;br&gt;پس از روشن‌شدن تعریف، همین نامزد دوباره ارزیابی می‌شود.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="166" width="650" x="1424" y="7866" as="geometry" />
        </mxCell>
        <mxCell id="active" parent="1" style="whiteSpace=wrap;html=1;fontFamily=PeydaWebVF;fontSize=17;fontColor=#214831;fillColor=#e8f4ed;strokeColor=#6c987c;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=12;overflow=hidden;rounded=0;fontSource=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fnetwordai%2Fnftword%40main%2FPeydaWebVF.woff;" value="&lt;div style=&quot;width:567px;max-width:100%;margin:auto;&quot;&gt;&lt;div dir=&quot;rtl&quot; style=&quot;font-size: 20px; font-weight: bold; line-height: 1.45; text-align: center;&quot;&gt;بیسِ تشکیل‌شده و بدون ناقضِ احرازشده&lt;/div&gt;&lt;div dir=&quot;rtl&quot; style=&quot;font-size: 17px; line-height: 1.55; text-align: center; margin-top: 7px;&quot;&gt;هنوز منتظر تأیید عملکرد است؛ نه سیگنال ورود.&lt;/div&gt;&lt;div dir=&quot;rtl&quot; style=&quot;font-size:12px;line-height:1.4;margin-top:8px;opacity:.8;&quot;&gt;تفکیک تشکیل از تأیید: بیس + ص۵&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="124" width="630" x="2117" y="7887" as="geometry" />
