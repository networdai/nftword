        <mxCell id="entry" parent="1" style="whiteSpace=wrap;html=1;fontFamily=PeydaWebVF;fontSize=17;fontColor=#44330c;fillColor=#fff7df;strokeColor=#b58b36;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=12;overflow=hidden;rhombus;fontSource=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fnetwordai%2Fnftword%40main%2FPeydaWebVF.woff;container=0;" value="&lt;div style=&quot;width:416px;max-width:100%;margin:auto;&quot;&gt;&lt;div dir=&quot;rtl&quot; style=&quot;font-size: 20px; font-weight: bold; line-height: 1.45; text-align: center;&quot;&gt;آیا منبع حاضر تریگر ورود کامل تعریف کرده؟&lt;/div&gt;&lt;div dir=&quot;rtl&quot; style=&quot;font-size: 17px; line-height: 1.55; text-align: center; margin-top: 7px;&quot;&gt;خیر؛ صفحهٔ ۹ فقط عنوان دارد.&lt;br&gt;تأیید بیس به‌تنهایی اجازهٔ خرید یا فروش نیست.&lt;/div&gt;&lt;div dir=&quot;rtl&quot; style=&quot;font-size:12px;line-height:1.4;margin-top:8px;opacity:.8;&quot;&gt;بیس + ص۹&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="650" x="4479" y="9910" as="geometry" />
