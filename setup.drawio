        <mxCell id="upgrade" parent="1" style="whiteSpace=wrap;html=1;fontFamily=PeydaWebVF;fontSize=17;fontColor=#44330c;fillColor=#fff7df;strokeColor=#b58b36;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=12;overflow=hidden;rhombus;fontSource=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fnetwordai%2Fnftword%40main%2FPeydaWebVF.woff;" value="&lt;div style=&quot;width:326px;max-width:100%;margin:auto;&quot;&gt;&lt;div dir=&quot;rtl&quot; style=&quot;font-size: 20px; font-weight: bold; line-height: 1.45; text-align: center;&quot;&gt;آیا پیشرو همنوعِ اضافه در ماقبل آن وجود دارد؟&lt;/div&gt;&lt;div dir=&quot;rtl&quot; style=&quot;font-size: 17px; line-height: 1.55; text-align: center; margin-top: 7px;&quot;&gt;بند ارتقای ۲ به ۳، مستقل از مسیر معمول آزمون سه‌کندلی است.&lt;/div&gt;&lt;div dir=&quot;rtl&quot; style=&quot;font-size:12px;line-height:1.4;margin-top:8px;opacity:.8;&quot;&gt;بیس + ص۲&lt;/div&gt;&lt;/div&gt;" vertex="1">
