        <mxCell id="trade_note" parent="1" style="whiteSpace=wrap;html=1;fontFamily=PeydaWebVF;fontSize=17;fontColor=#5f5540;fillColor=#fffdf7;strokeColor=#c4b692;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=12;overflow=hidden;shape=note;size=16;fontSource=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fnetwordai%2Fnftword%40main%2FPeydaWebVF.woff;container=0;" value="&lt;div style=&quot;width:684px;max-width:100%;margin:auto;&quot;&gt;&lt;div dir=&quot;rtl&quot; style=&quot;font-size: 20px; font-weight: bold; line-height: 1.45; text-align: center;&quot;&gt;قواعد محدود معامله که متن واقعاً دارد&lt;/div&gt;&lt;div dir=&quot;rtl&quot; style=&quot;font-size: 17px; line-height: 1.55; text-align: center; margin-top: 7px;&quot;&gt;فقط بیس اصلی: حرکت در جهت استقرار&lt;br&gt;SL بیس نزولی: زیر Low استقرار؛ SL بیس صعودی: بالای High استقرار&lt;br&gt;اهداف ۱۲ و ۲۴ با شرایط ذکر شده‌اند، اما فرمول‌شان اینجا نیست.&lt;br&gt;«حد محافظ» و ناقض شمارهٔ ۵ بدون شرح‌اند.&lt;br&gt;این موارد نه تریگر کامل‌اند و نه قاعدهٔ عمومی همهٔ بیس‌ها.&lt;/div&gt;&lt;div dir=&quot;rtl&quot; style=&quot;font-size:12px;line-height:1.4;margin-top:8px;opacity:.8;&quot;&gt;بیس + ص۳،۵،۸،۹&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="286" width="760" x="3560" y="9584" as="geometry" />
        </mxCell>
