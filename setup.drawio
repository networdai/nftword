        <mxCell id="plain" parent="1" style="whiteSpace=wrap;html=1;fontFamily=PeydaWebVF;fontSource=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fnetwordai%2Fnftword%40main%2FPeydaWebVF.woff;fontSize=17;align=center;verticalAlign=middle;spacing=0;strokeWidth=1.5;container=0;fillColor=#f5f8fa;strokeColor=#8ca1ac;fontColor=#18343f;points=[[0.5,0],[1,0.5],[0.5,1],[0,0.5]];rounded=0;" value="&lt;div dir=&quot;rtl&quot; style=&quot;width:449px;max-width:100%;margin:auto;font-family:PeydaWebVF;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.45;&quot;&gt;بدون صفت احرازشده / حالت مرزی&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:400;line-height:1.5;margin-top:6px;&quot;&gt;ویژگی پیشرو بودن، در صورت وجود، حفظ می‌شود.&lt;br&gt;برابری Open/Low/High، دوجی و جزئیات گپ با شکل حل نشده‌اند.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="152" width="510" x="2079" y="2065.5" as="geometry" />
        </mxCell>
        <mxCell id="pp" parent="1" style="whiteSpace=wrap;html=1;fontFamily=PeydaWebVF;fontSource=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fnetwordai%2Fnftword%40main%2FPeydaWebVF.woff;fontSize=17;align=center;verticalAlign=middle;spacing=0;strokeWidth=1.5;container=0;fillColor=#e8f4ed;strokeColor=#6c987c;fontColor=#214831;points=[[0.5,0],[1,0.5],[0.5,1],[0,0.5]];rounded=0;" value="&lt;div dir=&quot;rtl&quot; style=&quot;width:396px;max-width:100%;margin:auto;font-family:PeydaWebVF;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.45;&quot;&gt;پیشرو پیشتاز&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:400;line-height:1.5;margin-top:6px;&quot;&gt;K &amp;gt;= 2&lt;br&gt;P و دست‌کم یک کندل پیش از آن،&lt;br&gt;پیشرو همگونِ جهت قبلی‌اند.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="176" width="450" x="1375" y="2420" as="geometry" />
        </mxCell>
