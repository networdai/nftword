        <mxCell id="pioneer" parent="1" style="whiteSpace=wrap;html=1;fontFamily=PeydaWebVF;fontSource=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fnetwordai%2Fnftword%40main%2FPeydaWebVF.woff;fontSize=17;align=center;verticalAlign=middle;spacing=0;strokeWidth=1.5;container=0;fillColor=#e8f4ed;strokeColor=#6c987c;fontColor=#214831;points=[[0.5,0],[1,0.5],[0.5,1],[0,0.5]];rounded=0;" value="&lt;div dir=&quot;rtl&quot; style=&quot;width:352px;max-width:100%;margin:auto;font-family:PeydaWebVF;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.45;&quot;&gt;پیشتاز&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:400;line-height:1.5;margin-top:6px;&quot;&gt;تصویر ۱: بدنهٔ مخالف از Open قبلی عبور کرده؛&lt;br&gt;هنوز از Low قبلی نگذشته است.&lt;/div&gt;&lt;/div&gt;" vertex="1">
